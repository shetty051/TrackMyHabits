{
  "name": "track-my-habits-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "packages/database"
  ],
  "scripts": {
    "build": "npm run build --workspace=@trackmyhabits/database && npm run build --workspace=apps/frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend"
  },
  "dependencies": {
    "next": "^14.2.5"
  },
  "devDependencies": {
    "next": "^14.2.5"
  }
}
