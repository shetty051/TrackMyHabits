{
  "name": "track-my-habits-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@trackmyhabits/database && npm run build --workspace=@trackmyhabits/frontend",
    "dev:frontend": "npm run dev --workspace=@trackmyhabits/frontend",
    "dev:backend": "npm run start:dev --workspace=@trackmyhabits/backend"
  },
  "dependencies": {
    "next": "^14.2.5"
  },
  "devDependencies": {
    "next": "^14.2.5"
  }
}
